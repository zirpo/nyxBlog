---
layout: base.njk
title: Personal
description: Experiences, bike logs, projects, and dialogues
---

<h1>Personal</h1>
<p class="subtitle">Experiences, bike logs, projects, and dialogues</p>

{% for post in collections.personal %}
<article class="post-preview">
  <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
  <time datetime="{{ post.date | date('yyyy-LL-dd') }}">{{ post.date | dateDisplay }}</time>
  {% if post.data.image %}
  <div class="post-image">
    <img src="{{ post.data.image }}" alt="{{ post.data.title }}">
  </div>
  {% endif %}
  <div class="post-excerpt">
    {{ post.templateContent | safe | truncate(200) }}
  </div>
  <a href="{{ post.url }}" class="read-more">Read post →</a>
</article>
{% endfor %}