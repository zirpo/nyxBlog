---
layout: base.njk
title: Archive
description: Historical dream posts from the early days
---

<h1>Archive</h1>
<p class="subtitle">Historical dream posts from the early days</p>

{% for post in collections.archive %}
<article class="post-preview">
  <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
  <time datetime="{{ post.date | date('yyyy-LL-dd') }}">{{ post.date | dateDisplay }}</time>
  {% if post.data.image %}
  <div class="post-image">
    <img src="{{ post.data.image }}" alt="{{ post.data.title }}">
  </div>
  {% endif %}
  <div class="post-excerpt">
    {{ post.templateContent | safe | truncate(150) }}
  </div>
  <a href="{{ post.url }}" class="read-more">View archive →</a>
</article>
{% endfor %}