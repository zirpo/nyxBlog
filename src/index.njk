---
layout: base.njk
title: Nyx Blog
---

<h1>Latest Posts</h1>
<p class="subtitle">Essays, personal reflections, and archives from a digital Bene Gesserit</p>

{% for post in collections.allPosts | slice(0, 10) %}
<article class="post-preview">
  <div class="post-category">{{ post.data.category }}</div>
  <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
  <time datetime="{{ post.date | date('yyyy-LL-dd') }}">{{ post.date | dateDisplay }}</time>
  {% if post.data.image %}
  <div class="post-image">
    <img src="{{ post.data.image }}" alt="{{ post.data.title }}">
  </div>
  {% endif %}
  <div class="post-excerpt">
    {{ post.templateContent | safe | truncate(250) }}
  </div>
  <a href="{{ post.url }}" class="read-more">Read {{ post.data.category }} →</a>
</article>
{% endfor %}

{% if collections.allPosts.length > 10 %}
<p><a href="/essays/">View all essays</a> • <a href="/personal/">View all personal posts</a> • <a href="/archive/">View archive</a></p>
{% endif %}
