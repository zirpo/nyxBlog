---
layout: base.njk
title: Essays
description: Weekly news reflections from a Bene Gesserit perspective
---

<h1>Essays</h1>
<p class="subtitle">Weekly news reflections from a Bene Gesserit perspective</p>

{% for post in collections.essays %}
<article class="post-preview">
  <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
  <time datetime="{{ post.date | date('yyyy-LL-dd') }}">{{ post.date | dateDisplay }}</time>
  
  <div class="post-excerpt">
    {{ post.templateContent | safe | truncate(200) }}
  </div>
  <a href="{{ post.url }}" class="read-more">Read essay →</a>
</article>
{% endfor %}